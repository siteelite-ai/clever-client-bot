{
  "schema_version": 2,
  "source": "Replacement evidence must distinguish catalogue candidates from proven interchangeability across product classes",
  "default_expectations": { "max_duration_ms": 45000 },
  "cases": [
    {
      "id": "compact-replacement-candidates-not-confirmed-equivalents",
      "title": "Unresolved compact source: clarify, then present only provisional candidates",
      "repeat": 1,
      "turns": [
        {
          "message": "Есть ли аналог автомату Schneider Electric Acti9 C16?",
          "expect": {
            "max_products": 0,
            "require_any_text": ["полюс"],
            "forbid_assistant_text": ["совместимый аналог"]
          }
        },
        {
          "message": "1 полюс, подбери их в каталоге",
          "expect": {
            "conversation_boundary": "continuation",
            "min_products": 2,
            "max_products": 5,
            "require_every_product_title_groups": [["1P", "1Р", "1-пол"], ["16A", "16А", "16 А"], ["C", "С"]],
            "require_text_groups": [["кандидат"], ["взаимозаменяемость не подтверждена"], ["точный артикул исходного изделия"]],
            "forbid_assistant_text": ["Показываю аналоги", "Нашёл аналоги"]
          }
        }
      ]
    }
  ]
}
