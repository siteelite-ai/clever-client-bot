{
  "schema_version": 2,
  "source": "Targeted regression for catalog-filter provenance after the green-emission floodlight incident",
  "default_expectations": { "max_duration_ms": 45000 },
  "cases": [
    {
      "id": "white-yard-floodlight-provenance",
      "title": "Уличный прожектор для двора не подменяет белый свет цветным свечением",
      "repeat": 1,
      "turns": [
        {
