{
  "schema_version": 2,
  "source": "Решение заказчика 2026-10-20: для подбора термоусадки на кабель внутренний диаметр до усадки должен быть не меньше 120% диаметра кабеля; исторический пример 14/7 для Ø12 мм не является допустимым. Исторические V8-матрицы не изменены.",
  "default_expectations": { "max_duration_ms": 45000 },
  "cases": [
    {
      "id": "customer-heat-shrink-12mm-strict-reserve",
      "title": "Ø12 мм: запас до усадки ≥20%, после усадки диаметр меньше кабеля",
      "repeat": 1,
      "turns": [
        {
          "message": "подбери термоусадочную трубку для кабеля диаметром 12 мм",
          "expect": {
            "min_products": 1,
            "max_products": 5,
            "require_every_product_page": {
              "facets": [
                { "name": "Внутр диаметр до термоусадки,мм", "min_numeric": 14.4 },
                { "name": "Внутр диаметр после термоусадки, мм", "less_than": 12 }
              ]
            },
            "require_every_product_pair_around": 12,
            "forbid_product_title": ["14/7"],
            "forbid_text": ["search_catalog", "discover_category", "render_products"]
          }
        }
      ]
    },
    {
      "id": "customer-ttu-10mm-strict-reserve-boundary",
      "title": "Ø10 мм: размер 12/6 остаётся допустимым на границе 20%",
      "repeat": 1,
      "turns": [
        {
          "message": "подбери трубку ТТУ на кабель диаметром 10 мм",
          "expect": {
            "min_products": 1,
            "max_products": 5,
            "require_every_product_title_any": ["ТТУ"],
            "require_every_product_page": {
              "facets": [
                { "name": "Внутр диаметр до термоусадки,мм", "min_numeric": 12 },
                { "name": "Внутр диаметр после термоусадки, мм", "less_than": 10 }
              ]
            },
            "require_every_product_pair_around": 10,
            "forbid_text": ["search_catalog", "discover_category", "render_products"]
          }
        }
      ]
    }
  ]
}
