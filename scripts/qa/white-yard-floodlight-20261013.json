            "require_every_product_page": {
              "facets": [
                { "name": "Степень защиты", "exact_any": ["IP65", "IP66", "IP67", "IP68", "IP69", "IP69K"] },
                { "name": "Цветовая температура, К", "min_numeric": 4000, "less_than": 6501 }
              ]
            }
          }
        }
      ]
    }
  ]
