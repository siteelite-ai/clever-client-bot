{
  "schema_version": 2,
  "source": "Наблюдение заказчика 2026-10-13: серия после выбора раздела и последующего уточнения",
  "default_expectations": { "max_duration_ms": 45000 },
  "cases": [
    {
      "id": "regression-broad-series-three-turn-continuation",
      "title": "Ассортимент Gallant → Розетки → двойные электрические розетки",
      "repeat": 1,
      "turns": [
        {
          "message": "покажи ассортимент Gallant на сайте",
          "expect": {
            "max_products": 0,
            "require_clarification_choice": "either",
            "require_clarification_facet_key": "catalog_section"
          }
        },
        {
          "message": "Розетки",
          "expect": {
            "conversation_boundary": "continuation",
            "min_products": 1,
            "max_products": 5,
            "require_every_product_title_groups": [
              ["Gallant", "Галант"],
              ["розет"]
            ]
          }
        },
        {
          "message": "двойные электрические розетки",
          "expect": {
            "conversation_boundary": "continuation",
            "min_products": 3,
            "max_products": 5,
            "require_every_product_title_groups": [
              ["Gallant", "Галант"],
              ["розет"],
              ["двойн", "2 мест", "2-мест", "2 пост"]
            ],
            "require_selection_criteria_groups": [
              ["Gallant", "Галант"],
              ["Коллекц", "серия", "линейк"]
            ]
          }
        }
      ]
    }
  ]
}
