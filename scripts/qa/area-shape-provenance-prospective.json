{
  "schema_version": 1,
  "source": "Prospective opt-in regression for customer chandelier follow-up; does not replace or modify the pinned V9 suite",
  "default_expectations": { "max_duration_ms": 45000 },
  "cases": [
    {
      "id": "prospective-area-is-not-shape",
      "title": "Area quantity must not become a mandatory product-shape facet",
      "repeat": 1,
      "turns": [
        {
          "message": "хочу поменять дома люстру в зале 30 квадратов. Что предложишь из современного?",
          "expect": {
            "min_products": 3,
            "max_products": 5,
            "require_every_product_page": {
              "facets": [
                { "name": "Назначение", "require_any": ["гостин"] },
                { "name": "Максимальная площадь освещения, м2", "min_numeric": 30 }
              ]
            }
          }
        },
        {
          "message": "Они точно подходят для освещения 30 квадратных метров?",
          "expect": {
            "conversation_boundary": "continuation",
            "require_text_groups": [
              ["30 м²", "30 м2", "30 квадрат"],
              ["по каталог", "в карточк", "заявлен"],
              ["площадь освещения", "максимальная площадь"]
            ]
          }
        },
        {
          "message": "Почему варианты отличаются по цене? Сравни подтверждённые характеристики.",
          "expect": {
            "conversation_boundary": "continuation",
            "require_any_text": ["цен", "мощн", "управ", "характерист"]
          }
        },
        {
          "message": "А есть другие варианты?",
          "expect": {
            "conversation_boundary": "continuation",
            "min_products": 1,
            "max_products": 5,
            "require_new_product_skus": true,
            "require_every_product_page": {
              "facets": [
                { "name": "Назначение", "require_any": ["гостин"] },
                { "name": "Максимальная площадь освещения, м2", "min_numeric": 30 }
              ]
            },
            "require_shape_facet_provenance": true
          }
        }
      ]
    }
  ]
}
