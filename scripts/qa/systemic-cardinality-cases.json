  "cases": [
    {
      "id": "cardinality-multiple-sockets",
      "title": "Несколько вариантов розеток",
      "repeat": 3,
      "turns": [
        {
          "message": "Найди несколько двойных черных электрических розеток",
          "expect": {
            "min_products": 3,
            "max_products": 5,
